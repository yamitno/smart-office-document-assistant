# Copy this file to .env and fill in real values. Never commit .env.

# Base URL for the n8n webhooks (see CONTRACT.md).
# Example: https://alexkuznetsov.app.n8n.cloud/webhook
VITE_API_BASE_URL=

# Sent as the "x-api-key" header on every request (see CONTRACT.md).
# Example: 8f3e2c1a-4b6d-4e2f-9a1c-7d5e6f8a9b0c
VITE_API_KEY=

# Max allowed upload size in MB, enforced client-side before sending to n8n
# (F1/F8). Default per the assignment's suggested limit.
VITE_MAX_FILE_MB=10
